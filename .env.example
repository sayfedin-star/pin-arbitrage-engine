# Core Runtime & Security (Fail-Closed: set NODE_ENV=production on live servers)
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
ALLOWED_ORIGINS=

# Unified PostgreSQL Database & Connection Pool
DATABASE_URL=
PG_POOL_MAX=10

# Authentication & Automation Secrets
API_SECRET_KEY=
GITHUB_TOKEN=
GITHUB_REPOSITORY=sayfedin-star/pin-arbitrage-engine
PINTEREST_COOKIE=
NEWBORN_PINTEREST_COOKIE=

# InstaBox VPS Control Plane & Self-Sync
INSTABOX_API_KEY=
INSTABOX_MACHINE_ID=
INSTABOX_BOOT_SYNC=true
