# Core Runtime & Security (Fail-Closed: set NODE_ENV=production on live servers)
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
ALLOWED_ORIGINS=

# Unified PostgreSQL Database & Connection Pool
DATABASE_TOPOLOGY=unified_postgres
DATABASE_URL=
PG_POOL_MAX=10

# Authentication & Automation Secrets
API_SECRET_KEY=
GITHUB_TOKEN=
INSTABOX_API_KEY=
PINTEREST_COOKIE=