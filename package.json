{
  "name": "pin-arbitrage-engine",
  "version": "1.0.0",
  "description": "Pinterest Algorithmic Arbitrage Engine (P2P Cluster Intelligence, Fastify + PostgreSQL & GH Workflows)",
  "type": "module",
  "main": "src/server.mjs",
  "scripts": {
    "dev": "PORT=3000 HOST=0.0.0.0 node src/server.mjs",
    "build": "node scripts/check-syntax-and-templates.mjs",
    "start": "node src/server.mjs",
    "postinstall": "node scripts/patch-postgres.mjs",
    "crawl": "node --use-system-ca scripts/cluster-intelligence.mjs",
    "crawl:creators": "node --use-system-ca scripts/creator-velocity-crawler.mjs",
    "crawl:account-related": "node --use-system-ca scripts/account-related-crawler.mjs",
    "dashboard": "node --use-system-ca src/server.mjs",
    "enrich:domains": "node --use-system-ca scripts/domain-enrich.mjs --mode=whois",
    "enrich:ads": "node --use-system-ca scripts/domain-enrich.mjs --mode=ads",
    "lint": "npx eslint src/ scripts/ workers/ public/ tests/ --max-warnings=0",
    "check": "node scripts/check-syntax-and-templates.mjs && npm run lint",
    "test": "node --import \"data:text/javascript,process.env.NODE_ENV='test'\" --test \"tests/*.test.mjs\""
  },
  "keywords": [
    "pinterest",
    "arbitrage",
    "p2p-cluster",
    "postgresql",
    "algorithmic-intelligence",
    "fastify"
  ],
  "author": "sayfedin-star",
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.2.1",
    "postgres": "3.4.9",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "puppeteer-core": "^25.16.0"
  }
}
