+    cookie = `_auth=0; ${cookie}`.trim();
+  }
+  // Clean double semicolons and extra spaces
+  return cookie
+    .replace(/;\s*;/g, ';')
+    .replace(/;\s+/g, '; ')
+    .replace(/^;\s*/, '')
+    .replace(/;\s*$/, '')
