+INSERT INTO public.schema_migrations (version, name, checksum, applied_at)
+VALUES ('062', 'ssot_hot_tuning_and_functions', 'phase5_ssot_hot_tuning_062', NOW())
+ON CONFLICT (version) DO UPDATE SET applied_at = NOW();
